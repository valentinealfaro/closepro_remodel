# Copy this file to .env and fill in your real values. Never commit .env to git.

# ── Anthropic (Claude AI Agents — server-side only, never exposed to browser) ─
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these from Firebase Console > Project Settings > Your Apps > SDK setup
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_FIRESTORE_DB_ID=(default)

# ── Firebase Service Account (for server-side Firestore operations) ──────────
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Or set as JSON string in FIREBASE_SERVICE_ACCOUNT_KEY
# For local dev, you can also set GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project_id",...}

# ── Stripe (for payments) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_FIRESTORE_DB_ID=(default)

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Gemini keys are NOT injected into the client bundle anymore. Each contractor
# brings their own (BYOK) and it's stored encrypted in Firestore. The two vars
# below only matter for the public marketing demo on / and /ai-demo.
CLOSEPRO_DEMO_KEY=your_demo_gemini_api_key_here
# Legacy fallback name (server-side only). New code uses CLOSEPRO_DEMO_KEY.
GEMINI_API_KEY=your_demo_gemini_api_key_here

# ── BYOK encryption ───────────────────────────────────────────────────────────
# Used by lib/crypto.ts to encrypt tenant Google API keys at rest. ≥32 chars.
# Generate with: openssl rand -base64 32
# IMPORTANT: use a DIFFERENT value in prod than local. Rotating this invalidates
# every saved tenant key — they'll need to re-enter them.
ENCRYPTION_KEY=replace_with_at_least_32_random_characters_______

# ── Stripe ────────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# Get from `stripe listen` (dev) or Stripe Dashboard > Webhooks (prod)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_URL=https://yoursite.com
